# Scraper User Agent
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36

# Web UI Server Configuration
HOST=0.0.0.0
PORT=8000

# Browser Execution (true for headless, false for visible browser window)
HEADLESS=true

# Storage Directories (defaults to ./data and ./feeds)
DATA_DIR=data
FEEDS_DIR=feeds

# Optional: Custom browser binary paths (only needed if not using bundled Playwright Chromium)
BRAVE_PATH=
CHROME_PATH=
